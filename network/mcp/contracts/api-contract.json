{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Comfy Gateway API Contract Boundary",
  "version": "1.0.0",
  "description": "Explicit transport, authentication, and endpoint contracts for the Comfy Gateway runtime in isolate and baseline.",
  "transport": {
    "protocol": "HTTP/1.1",
    "default_port": 8721,
    "fallback_port": 8720,
    "auth_header": "X-Comfy-Key",
    "accepted_keys": [
      "comfy-dev-local",
      "valheim-mod-local"
    ]
  },
  "endpoints": [
    {
      "path": "/healthz",
      "method": "GET",
      "auth_required": false,
      "response": {
        "status": 200,
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["ok", "degraded"] },
            "version": { "type": "string" }
          },
          "required": ["status"]
        }
      }
    },
    {
      "path": "/identity",
      "method": "GET",
      "auth_required": true,
      "response": {
        "status": 200,
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "source_root": { "type": "string" },
            "revision": { "type": "string" },
            "image": { "type": "string" },
            "profile": { "type": "string" },
            "port": { "type": "integer" }
          },
          "required": ["source_root", "image", "profile", "port"]
        }
      }
    },
    {
      "path": "/mcp",
      "method": "POST",
      "auth_required": true,
      "protocol": "FastMCP JSON-RPC 2.0",
      "description": "MCP tool invocation and streaming endpoint."
    }
  ]
}
