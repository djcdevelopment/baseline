<?xml version="1.0" encoding="utf-8"?>
<!--
  Local-feed rehearsal for the shared-contracts NuGet packages (Comfy.Quest.Contracts,
  Comfy.Transport.Contracts) described in the sovereign-repo-split plan. artifacts/nuget is
  gitignored (build output); this file is tracked so the local source resolves the same way
  for every checkout and inside the sdk:9.0 container (relative path). Local source is listed
  first so a local pack always wins over anything already published under the same id+version.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-contracts" value="artifacts/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
