{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfy.dev/schemas/observation-evidence-v1.json",
  "title": "ObservationEvidenceV1",
  "type": "object",
  "required": [
    "schema_version",
    "observation_id",
    "producer",
    "evidence_kind",
    "subject",
    "provenance",
    "quality",
    "correlation_spine"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ObservationEvidence/v1"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "runtime_observer",
            "arcane_sight",
            "network_sense",
            "steward_view",
            "human_feedback"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence_kind": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "quest_revision",
        "node_id",
        "anchor_id"
      ],
      "properties": {
        "quest_revision": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "anchor_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "session_id",
        "observed_at"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": [
        "classification"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "observed",
            "inferred",
            "unverified"
          ]
        }
      },
      "additionalProperties": false
    },
    "correlation_spine": {
      "type": "object",
      "required": [
        "source_revision",
        "compiled_quest_revision",
        "install_request_id",
        "active_runtime_revision",
        "anchor_id",
        "event_node_id"
      ],
      "properties": {
        "source_revision": {
          "type": "string"
        },
        "compiled_quest_revision": {
          "type": "string"
        },
        "install_request_id": {
          "type": "string"
        },
        "active_runtime_revision": {
          "type": "string"
        },
        "anchor_id": {
          "type": "string"
        },
        "event_node_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
