{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfy.dev/schemas/install-quest-pack-v1.json",
  "title": "InstallQuestPackV1",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "source_revision",
    "compiled_quest_revision",
    "questpack_payload_sha256",
    "requested_by"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "InstallQuestPack/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "compiled_quest_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "questpack_payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requested_by": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
