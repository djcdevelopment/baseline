{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfy.dev/schemas/comfy-quest-experience-v1.json",
  "title": "ComfyQuestExperienceV1",
  "type": "object",
  "required": [
    "schema_version",
    "quest_id",
    "title",
    "nodes",
    "spatial_anchors",
    "required_capabilities",
    "action_references",
    "checksum_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "comfy-quest-experience/v1"
    },
    "quest_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "title": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "node_type",
          "exec_mode"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "node_type": {
            "type": "string",
            "enum": [
              "event_trigger",
              "condition",
              "action",
              "state_machine"
            ]
          },
          "exec_mode": {
            "type": "string",
            "enum": [
              "single_tick",
              "bounded_state_machine",
              "timer_rearm"
            ]
          },
          "anchor_id": {
            "type": "string"
          },
          "next_nodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "max_tick_depth": {
            "type": "integer",
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    },
    "spatial_anchors": {
      "type": "array",
      "items": {
        "$ref": "spatial-anchor-v1.json"
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checksum_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
