# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# scratch / local-only
scratch/
*.tmp

# Local generated evidence/artifacts from release cuts, modpack packaging, and
# Wave 0/live-gate smoke runs. Public-safe summaries that need to persist should
# be copied into docs/roadmap/ or another explicit source/evidence location.
captures/
artifacts/

# Terraform local state and operator-specific inputs
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
__pycache__/

# generated local bridge outputs
bridge-review/
support-report.*

# .NET / mod build outputs
bin/
obj/
*.dll
*.pdb
*.zip

# dotnet test result artifacts (TRX loggers write here; nearly committed 16 of
# these on 2026-07-21 while chasing an intermittent Game.Simulation.Tests failure)
TestResults/
*.trx

# large game data (world saves are found separately, not committed)
*.db
*.fwl
*.fch

# Field-lab runtime + generated (not source): container state (~30GB), run packets, gateway var
# The run catalog (index.json/CATALOG.md) is tracked M0 evidence; run packets stay local.
fieldlab/autonomous/state/
fieldlab/runs/*
!fieldlab/runs/index.json
!fieldlab/runs/CATALOG.md
network/mcp/var/
network/var/

# Private, non-source analysis of miker's exported staff chat (internal only, do not commit)
comfy-miker-analysis/

# Private, non-source analysis of Tugcow's own Discord export (internal only, do not commit)
# Belt-and-suspenders: the whole folder is ignored, and revealed name maps are double-ignored.
comfy-tugcow-analysis/
*.revealed.csv

# Private synthesis built ON TOP of the two analyses above (two more abstraction layers).
# Derived from private material — same stance: internal only, do not commit.
comfy-ascent-analysis/

# Session-transcript audit extract: contains raw operator voice transcripts - keep private
fieldlab-session-audit/

# Local operator secrets for the OMEN smoke (Lumberjacks network password) - never commit
fieldlab/scripts/omen-client-smoke.secrets.ps1
*.secrets.ps1

# Discord bot token and any local env file. The canonical home for the token is OUTSIDE
# this repo (%USERPROFILE%\.baseline\workbench-discord.token) and the provisioning script
# refuses to read one from inside it - these patterns are the backstop, not the policy.
*.token
.env
.env.*

# Discord thread exports: real display names next to what people said. Same stance as
# the candidate-issues journal - internal only. Keep exports outside the repo; this
# catches the case where someone points --out at it anyway.
workbench-exports/

# Vendored metadata reader for New-ReleaseCut.ps1's artifact identity check.
# Windows PowerShell 5.1 has no GAC entry for System.Reflection.Metadata, so the
# check cannot load it via Add-Type -AssemblyName. These netstandard2.0 builds do
# load on .NET Framework 4.8. Vendored so a nuget cache clear cannot silently
# disarm the one gate that stops a mismatched release from shipping.
!infra/gcp/p7/scripts/lib/*.dll
# Local Docker override that grants the Companion write access to a specific Valheim install.
Lumberjacks/tools/companion/docker-compose.valheim.yml
