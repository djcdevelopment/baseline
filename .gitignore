# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# scratch / local-only
scratch/
*.tmp

# Local generated evidence/artifacts from release cuts, modpack packaging, and
# Wave 0/live-gate smoke runs. Public-safe summaries that need to persist should
# be copied into docs/roadmap/ or another explicit source/evidence location.
captures/
artifacts/

# Terraform local state and operator-specific inputs
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
__pycache__/
node_modules/

# generated local bridge outputs
bridge-review/
support-report.*

# .NET / mod build outputs
bin/
obj/
*.dll
*.pdb
*.zip

# dotnet test result artifacts (TRX loggers write here; nearly committed 16 of
# these on 2026-07-21 while chasing an intermittent Game.Simulation.Tests failure)
TestResults/
*.trx

# large game data (world saves are found separately, not committed)
*.db
*.fwl
*.fch

# Field-lab historical run packets. The run catalog (index.json/CATALOG.md) is
# tracked evidence; newly captured packets stay local until deliberately promoted.
fieldlab/runs/*
!fieldlab/runs/index.json
!fieldlab/runs/CATALOG.md

# Pre-split generated/runtime residue is intentionally neither deleted nor tracked
# by the split commit. These paths are not implementation authority; current lanes
# live in lumberjacks-platform and isolate.
fieldlab/autonomous/state/
network/mcp/var/
Lumberjacks/tools/companion/dist/
Lumberjacks/tools/companion/docker-compose.valheim.yml

# Private, non-source analysis of miker's exported staff chat (internal only, do not commit)
comfy-miker-analysis/

# Private, non-source analysis of Tugcow's own Discord export (internal only, do not commit)
# Belt-and-suspenders: the whole folder is ignored, and revealed name maps are double-ignored.
comfy-tugcow-analysis/
*.revealed.csv

# Private synthesis built ON TOP of the two analyses above (two more abstraction layers).
# Derived from private material — same stance: internal only, do not commit.
comfy-ascent-analysis/

# Session-transcript audit extract: contains raw operator voice transcripts - keep private
fieldlab-session-audit/

# Local operator secrets - never commit.
*.secrets.ps1

# Discord bot token and any local env file. The canonical home for the token is OUTSIDE
# this repo (%USERPROFILE%\.baseline\) and the provisioning script refuses to read one
# from inside it - these patterns are the backstop, not the policy.
# `*.env` and not just `.env`: a token file landed at the repo root as `discord.env` on
# 2026-07-29, which `.env` does not match, and this repo's automation commits and pushes
# on its own. Nothing tracked matches these patterns.
*.token
*.env
.env
.env.*
# Called out by name as well as by pattern: this is the Discord bot token file, it
# landed at the repo root once, and a bare pattern is easy to miss when skimming.
discord.env
**/discord.env

# Local OAuth client configuration and tokens. Quest Lab's Google Sheets companion
# stores both outside the repo, but these patterns prevent an accidental copied fixture
# from entering source control.
desktop-oauth-client.json
oauth-token.json
oauth-token.dpapi
client_secret*.json
