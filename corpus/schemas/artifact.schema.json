{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://djcdevelopment.github.io/baseline/corpus/artifact.schema.json",
  "title": "Baseline colocated artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "title",
    "summary",
    "audiences",
    "canonical_url",
    "published_at",
    "source_files"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
    "kind": { "enum": ["story", "guide", "portal"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "audiences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "relevant"],
      "properties": {
        "primary": { "$ref": "#/$defs/audienceIds" },
        "relevant": { "$ref": "#/$defs/audienceIds" }
      }
    },
    "canonical_url": { "type": "string", "pattern": "^https://" },
    "published_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "facets": {
      "type": "object",
      "additionalProperties": { "type": ["string", "boolean", "number", "array"] }
    }
  },
  "$defs": {
    "audienceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    }
  }
}
