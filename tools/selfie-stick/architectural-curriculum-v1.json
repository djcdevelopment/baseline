    "minimum_independent_scale_anchors": 2,
    "maximum_scale_anchor_spread_ratio": 0.05,
    "maximum_cross_view_error_m": 0.25,
    "maximum_cross_view_error_ratio": 0.03,
    "maximum_pieces": 256,
